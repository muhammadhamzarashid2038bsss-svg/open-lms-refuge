# Copy this file to .env and fill in real values. Never commit .env.
# These names match the Phase 1 stack in docs/PRD.md (Next.js, PostgreSQL, risk service).

# PostgreSQL connection string used by Prisma.
# Example local value: postgresql://USER:PASSWORD@localhost:5432/open_lms_refuge
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Cap on the pg pool used by Prisma (lib/db.ts). Use 1 with `npx prisma dev`.
# On Vercel, set this to 1 and point DATABASE_URL at Neon's pooled address.
# If it is unset in production, the app uses 1 rather than the driver default of 10.
# Migrations use Neon's direct address and `npm run db:migrate:deploy`, not this pool.
# DATABASE_POOL_MAX=1

# Optional scratch database Prisma Migrate uses when checking migrations.
# Leave this unset for a normal PostgreSQL server. Prisma creates the scratch
# database itself. If you use `npx prisma dev` for a local Postgres, paste the
# SHADOW_DATABASE_URL that command prints.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/SHADOW_DATABASE"

# Key for donor-export pseudonyms (FEAT-4). The server mixes this into
# HMAC-SHA-256. A plain hash of a learner code is not enough: codes are short
# and the hash recipe is public, so a guessed code can be checked offline.
# Without this key, the same guess does not match the pseudonym in the file.
# Exactly 64 lowercase hexadecimal characters. That is 32 random bytes.
# Generate a new one per deploy. Do not reuse a password or this placeholder.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPORT_SECRET="replace-with-a-long-random-secret"

# Base URL of the Python FastAPI risk-scoring service (FEAT-3).
# Local development uses http on localhost. A service on another computer must use https.
# The browser never calls this address. The Next.js server does.
RISK_SERVICE_URL="http://127.0.0.1:8000"

# Shared key the Next.js server sends to the risk service. Not a NEXT_PUBLIC_ variable.
# Use the same value when you start the Python service. Generate a long random string.
# The published example below is rejected by the app and by the Python service.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RISK_SERVICE_API_KEY="replace-with-a-long-random-secret"

# Public URL of this web app (used for links in emails or PDFs later).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seals the sign-in cookie. At least 32 characters. Generate a new one per deploy.
# The published example below is long enough to pass that length check, and it is still rejected.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# Private homework files on Backblaze B2, through its S3-compatible API.
# Leave these empty until you type them yourself. If any value is missing or
# invalid, file upload reports storage unavailable. There is no public fallback.
# Never prefix these with NEXT_PUBLIC_. The browser must not receive them.
# Setup notes: docs/STORAGE.md
OBJECT_STORAGE_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
OBJECT_STORAGE_REGION="eu-central-003"
OBJECT_STORAGE_BUCKET="open-lms-refuge-private"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
