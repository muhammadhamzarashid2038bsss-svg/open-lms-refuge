# Copy this file to .env and fill in real values. Never commit .env.
# These names match the Phase 1 stack in docs/PRD.md (Next.js, PostgreSQL, risk service).

# PostgreSQL connection string used by Prisma.
# Example local value: postgresql://USER:PASSWORD@localhost:5432/open_lms_refuge
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Optional cap on the pg pool used by Prisma (lib/db.ts). Use 1 with `npx prisma dev`.
# DATABASE_POOL_MAX=1

# Optional scratch database Prisma Migrate uses when checking migrations.
# Leave this unset for a normal PostgreSQL server. Prisma creates the scratch
# database itself. If you use `npx prisma dev` for a local Postgres, paste the
# SHADOW_DATABASE_URL that command prints.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/SHADOW_DATABASE"

# Secret used to HMAC-hash learner IDs in donor exports (FEAT-4).
# Generate a long random string. Do not reuse passwords.
PII_HMAC_SECRET="replace-with-a-long-random-secret"

# Base URL of the Python FastAPI risk-scoring service (FEAT-3).
RISK_SERVICE_URL="http://localhost:8000"

# Public URL of this web app (used for links in emails or PDFs later).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seals the sign-in cookie. At least 32 characters. Generate a new one per deploy.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret"
