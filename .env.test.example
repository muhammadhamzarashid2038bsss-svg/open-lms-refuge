# Copy this file to .env.test. Never commit .env.test.
# This URL is only for the local native PostgreSQL test database.
# Replace <URL_ENCODED_PASSWORD> with the test role password, URL-encoded.
# Do not put the development or Prisma Dev URL here.

TEST_DATABASE_URL="postgresql://open_lms_refuge_test:<URL_ENCODED_PASSWORD>@127.0.0.1:5433/open_lms_refuge_test?schema=public"

# Connections used by the test Prisma client. 4 is enough for one Vitest worker.
TEST_DATABASE_POOL_MAX=4
